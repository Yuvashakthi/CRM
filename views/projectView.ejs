<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CRM - Project View</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="container">
    
    <!-- Sidebar Navigation -->
    <aside class="sidebar">
      <h2>CRM</h2>
      <ul>
        <li><a href="/dashboard">Dashboard</a></li>
        
        <!-- Customers Dropdown -->
        <li>
          <a href="#" class="dropdown" onclick="toggleDropdown('customerDropdown')">Customers ▾</a>
          <ul id="customerDropdown" class="dropdown-menu">
            <li><a href="/clients">Clients</a></li>
            <li><a href="/customersCreate">Create Client</a></li>
          </ul>
        </li>

        <!-- Projects Dropdown -->
        <li>
          <a href="#" class="dropdown" onclick="toggleDropdown('projectDropdown')">Projects ▾</a>
          <ul id="projectDropdown" class="dropdown-menu">
            <li><a href="/projectView">Project View</a></li>
            <li><a href="/projectCreate">Project Create</a></li>
          </ul>
        </li>

           <!-- Invoice Dropdown -->
        <li>
          <a href="#" class="dropdown" onclick="toggleDropdown('invoiceDropdown')">Invoices ▾</a>
          <ul id="invoiceDropdown" class="dropdown-menu">
            <li><a href="/invoiceView">Invoice View</a></li>
            <li><a href="/invoice">Invoice Create</a></li>
          </ul>
        </li>

         <!-- Billing Dropdown -->
         <li>
          <a href="#" class="dropdown" onclick="toggleDropdown('billingDropdown')">Billings ▾</a>
          <ul id="billingDropdown" class="dropdown-menu">
            <li><a href="/billingView">View Billings</a></li>
            <li><a href="/billing">Create Billing</a></li>
          </ul>
        </li>
         
      </ul>
    </aside>

    <!-- Main Content -->
    <main class="content">
      <h1>Project List</h1>
      <table>
          <thead>
              <tr>
                  <th>Project ID</th>
                  <th>Project Name</th>
                  <th>Client ID</th>
                  <th>Client Name</th>
                  <th>Department</th>
                  <th>Project Type</th>
                  <th>Status</th>
                  <th>Actions</th>
              </tr>
          </thead>
          <tbody>
              <% projects.forEach(project => { %>
              <tr>
                  <td><%= project.projectId %></td>
                  <td><%= project.projectName %></td>
                  <td><%= project.clientId %></td>
                  <td><%= project.clientName %></td>
                  <td><%= project.department %></td>
                  <td><%= project.projectType %></td>
                  <td><%= project.status %></td>
                  <td>
                    <button onclick="window.location.href='/customerView/<%= project.clientId %>'">View</button>
                    <button onclick="openProjectEditModal('<%= project.clientId %>')">Edit</button>
                  </td>

              <% }); %>
          </tbody>
      </table>

      <!-- Project Details Modal -->
      <div id="projectDetailsModal" class="modal-edit" style="display: none;">
        <div class="modal-box">
          <h3>Project Details</h3>
          <div class="project-details">
            <label>Project ID:
              <input type="text" id="projId" readonly />
            </label>

            <label>Project Name:
              <input type="text" id="projName" disabled />
            </label>

            <label>Client ID:
              <input type="text" id="projClientId" readonly />
            </label>

            <label>Client Name:
              <input type="text" id="projClientName" disabled />
            </label>

            <label>Department:
              <input type="text" id="projDepartment" disabled />
            </label>

            <label>Project Type:
              <input type="text" id="projType" disabled />
            </label>

            <label>Assigned To:
              <input type="text" id="projAssigned" disabled />
            </label>

            <label>Start Date:
              <input type="date" id="projStart" disabled />
            </label>

            <label>End Date:
              <input type="date" id="projEnd" disabled />
            </label>

            <label>Status:
              <input type="text" id="projStatus" disabled />
            </label>

            <label>Worth/Cost:
              <input type="number" id="projWorth" disabled />
            </label>

            <div class="modal-buttons">
              <button type="button" onclick="enableProjectEditing()">Edit</button>
              <button type="button" id="saveProjectBtn" onclick="saveProjectChanges()" style="display: none;">Save</button>
              <button type="button" onclick="closeProjectDetailsModal()">Close</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Edit Project Modal -->
      <div id="editProjectModal" class="modal">
        <div class="modal-content">
          <span class="close" onclick="closeProjectModal()">&times;</span>
          <h2>Edit Project</h2>
          <form id="editProjectForm">
            <label>Project ID: <input type="text" id="editProjectId" name="projectId" readonly /></label>
            <label>Client ID: <input type="text" id="editClientId" name="clientId" readonly /></label>
            <label>Client Name: <input type="text" id="editClientName" name="clientName" /></label>
            <label>Department: <input type="text" id="editDepartment" name="department" /></label>
            <label>Project Name: <input type="text" id="editProjectName" name="projectName" required /></label>
            <label>Project Type: <input type="text" id="editProjectType" name="projectType" /></label>
            <label>Status: <input type="text" id="editStatus" name="status" /></label>
            <div style="margin-top: 10px;">
              <button type="submit">Save</button>
              <button type="button" onclick="closeProjectModal()">Cancel</button>
            </div>
          </form>
        </div>
      </div>
      
    </main>
    
  </div>

  <script src="/script.js"></script>
  <script>
    let currentProjectId = null;

    // View Project Function - Similar to clients.ejs view functionality
    async function viewProject(projectId) {
      try {
        const res = await fetch(`/api/projects/${projectId}`, {
          headers: { 'Accept': 'application/json' }
        });
        
        if (!res.ok) {
          throw new Error('Failed to fetch project data');
        }
        
        const data = await res.json();
        const project = data.project;

        // Populate the modal with project data
        document.getElementById('projId').value = project.projectId || '';
        document.getElementById('projName').value = project.projectName || '';
        document.getElementById('projClientId').value = project.clientId || '';
        document.getElementById('projClientName').value = project.clientName || '';
        document.getElementById('projDepartment').value = project.department || '';
        document.getElementById('projType').value = project.projectType || '';
        document.getElementById('projAssigned').value = project.assignedTo || '';
        document.getElementById('projStart').value = project.startDate ? new Date(project.startDate).toISOString().split('T')[0] : '';
        document.getElementById('projEnd').value = project.endDate ? new Date(project.endDate).toISOString().split('T')[0] : '';
        document.getElementById('projStatus').value = project.status || '';
        document.getElementById('projWorth').value = project.cost || project.worth || '';

        // Store current project ID for editing
        currentProjectId = project._id;

        // Show the modal
        document.getElementById('projectDetailsModal').style.display = 'flex';
      } catch (err) {
        console.error('Error fetching project details:', err);
        alert('Failed to load project details');
      }
    }

    // Close Project Details Modal
    function closeProjectDetailsModal() {
      document.getElementById('projectDetailsModal').style.display = 'none';
      // Reset fields to disabled state
      const fields = ["projName", "projType", "projAssigned", "projStart", "projEnd", "projStatus", "projWorth"];
      fields.forEach(id => document.getElementById(id).disabled = true);
      document.getElementById("saveProjectBtn").style.display = "none";
    }

    // Enable Project Editing
    function enableProjectEditing() {
      const fields = ["projName", "projType", "projAssigned", "projStart", "projEnd", "projStatus", "projWorth"];
      fields.forEach(id => document.getElementById(id).disabled = false);
      document.getElementById("saveProjectBtn").style.display = "inline-block";
    }

    // Save Project Changes
    async function saveProjectChanges() {
      const updatedData = {
        projectName: document.getElementById("projName").value,
        projectType: document.getElementById("projType").value,
        assignedTo: document.getElementById("projAssigned").value,
        startDate: document.getElementById("projStart").value,
        endDate: document.getElementById("projEnd").value,
        status: document.getElementById("projStatus").value,
        cost: parseFloat(document.getElementById("projWorth").value) || 0
      };

      try {
        const res = await fetch(`/projects/update/${currentProjectId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(updatedData)
        });

        const result = await res.json();

        if (!res.ok) {
          alert(result.error || "Failed to update project");
          return;
        }

        alert("Project updated successfully!");
        closeProjectDetailsModal();
        location.reload();
      } catch (err) {
        console.error("Error updating project:", err);
        alert("Server error");
      }
    }

    // Edit Project Modal Functions
    async function openProjectEditModal(projectId) {
      try {
        const res = await fetch(`/api/projects/${projectId}`);
        const data = await res.json();
        const project = data.project;

        document.getElementById('editProjectId').value = project.projectId;
        document.getElementById('editClientId').value = project.clientId;
        document.getElementById('editClientName').value = project.clientName || '';
        document.getElementById('editDepartment').value = project.department || '';
        document.getElementById('editProjectName').value = project.projectName;
        document.getElementById('editProjectType').value = project.projectType;
        document.getElementById('editStatus').value = project.status || '';

        document.getElementById('editProjectForm').setAttribute('data-id', project._id);
        document.getElementById('editProjectModal').style.display = 'block';
      } catch (err) {
        console.error('Failed to load project data:', err);
        alert('Error loading project details.');
      }
    }

    function closeProjectModal() {
      document.getElementById('editProjectModal').style.display = 'none';
    }

    document.getElementById('editProjectForm').addEventListener('submit', async function (e) {
      e.preventDefault();
      const form = e.target;
      const projectId = form.getAttribute('data-id');
      const formData = new URLSearchParams(new FormData(form)).toString();

      try {
        const res = await fetch(`/projects/update/${projectId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: formData
        });

        if (res.ok) {
          alert('Project updated successfully.');
          closeProjectModal();
          location.reload();
        } else {
          const error = await res.json();
          alert(error.error || 'Update failed');
        }
      } catch (err) {
        console.error('Update error:', err);
        alert('Server error');
      }
    });

    // Show Project Details (Alternative function if needed)
    function showProjectDetails(projectId) {
      fetch(`/projects/${projectId}`)
        .then(response => response.json())
        .then(project => {
          document.getElementById("modalProjectName").textContent = project.projectName;
          document.getElementById("modalProjectId").textContent = project.projectId;
          document.getElementById("modalClientId").textContent = project.clientId;
          document.getElementById("modalProjectType").textContent = project.projectType;
          document.getElementById("modalAssignedTo").textContent = project.assignedTo;
          document.getElementById("modalStartDate").textContent = project.startDate ? new Date(project.startDate).toDateString() : "N/A";
          document.getElementById("modalEndDate").textContent = project.endDate ? new Date(project.endDate).toDateString() : "N/A";
          document.getElementById("modalStatus").textContent = project.status;
          document.getElementById("modalWorth").textContent = `₹${project.cost || project.worth}`;

          document.getElementById("projectModal").style.display = "block";
        })
        .catch(error => console.error("Error fetching project details:", error));
    }

    function closeModal() {
      document.getElementById("projectModal").style.display = "none";
    }

    // View Client function (if you want to keep the redirect to client page)
    function viewClient(clientId) {
      window.location.href = `/clients/${clientId}`;
    }

  </script>
</body>
</html>