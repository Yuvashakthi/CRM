<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CRM - Navi Promotions</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="container">
    <!-- Sidebar Navigation -->
   <!-- Sidebar Navigation -->
    <aside class="sidebar">
      <h2>CRM</h2>
      <ul>
        <li><a href="/dashboard">Dashboard</a></li>
        
        <!-- Customers Dropdown -->
        <li>
          <a href="#" class="dropdown" onclick="toggleDropdown('customerDropdown')">Customers ▾</a>
          <ul id="customerDropdown" class="dropdown-menu">
            <li><a href="/clients">Clients</a></li>
            <li><a href="/customersCreate">Create Client</a></li>
          </ul>
        </li>

        <!-- Projects Dropdown -->
        <li>
          <a href="#" class="dropdown" onclick="toggleDropdown('projectDropdown')">Projects ▾</a>
          <ul id="projectDropdown" class="dropdown-menu">
            <li><a href="/projectView">Project View</a></li>
            <li><a href="/projectCreate">Project Create</a></li>
          </ul>
        </li>

           <!-- Invoice Dropdown -->
        <li>
          <a href="#" class="dropdown" onclick="toggleDropdown('invoiceDropdown')">Invoices ▾</a>
          <ul id="invoiceDropdown" class="dropdown-menu">
            <li><a href="/invoiceView">Invoice View</a></li>
            <li><a href="/invoice">Invoice Create</a></li>
          </ul>
        </li>

         <!-- Billing Dropdown -->

          <!-- Billing Dropdown -->
          <li>
            <a href="#" class="dropdown" onclick="toggleDropdown('billingDropdown')">Billings ▾</a>
            <ul id="billingDropdown" class="dropdown-menu">
              <li><a href="/billingView">View Billings</a></li>
              <li><a href="/billing">Create Billing</a></li>
            </ul>
          </li>
         
      </ul>
    </aside>


    <main class="content" id="content">
      <h1 class="form-wrapper" style="color:#00488E;">Create Project</h1>
      <div class="form-wrapper">
        <form action="/api/projects" method="POST" class="project-form">
          <label>Project ID:
            <input type="text" name="projectId" id="projectId" readonly required />

          </label>
          
          <label>Project Name: <input type="text" name="projectName" required /></label>

          <label>Client ID:
            <input type="text" name="clientId" id="clientId" oninput="fetchClientDetails('id')" required />
          </label>
      
      
          <label>Client Name:
            <input type="text" name="clientName" id="clientName" oninput="fetchClientDetails('name')" required />
          </label>
      
          <label>Department:
            <select name="department" id="department" onchange="updateAssignedTo()" required>
              <option value="">Select</option>
              <option value="Development">Development</option>
              <option value="Graphic Designing">Graphic Designing</option>
            </select>
          </label>
      
          <label>Assigned To:
            <select name="assignedTo" id="assignedTo" required>
              <option value="">Select</option>
            </select>
          </label>
      
          <label>Project Type: <input type="text" name="projectType" /></label>
          <label>Start Date: <input type="date" name="startDate" /></label>
          <label>End Date: <input type="date" name="endDate" /></label>
          <label>Status: <input type="text" name="status" /></label>
          <label>Worth (in INR): <input type="text" name="worth" /></label>
          <button type="submit">Create Project</button>
        </form>
      </div>
     
      
    </main>
    
  </div>

  <script src="/script.js"></script>
  <script>
    async function submitProject(event) {
      event.preventDefault();
      const formData = new FormData(event.target);
  
      const data = Object.fromEntries(formData.entries());
  
      try {
        const response = await fetch('/api/projects', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });
  
        const result = await response.json();
  
        if (response.ok) {
          alert('Project created successfully!');
          event.target.reset(); // Reset the form fields without redirection
        } else {
          alert(result.error || 'Failed to create project. Please try again.');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Error submitting project. Please try again.');
      }
    }
  
    // Attach event listener to form
    document.querySelector('form').addEventListener('submit', submitProject);


    const staffByDepartment = {
      "Development": ["Manjubashini", "Yuvashakthi", "Jacinth Sharon"],
      "Graphic Designing": ["Sathees Kumar", "Manoj Kumar"]
    };

    function updateAssignedTo() {
      const dept = document.getElementById('department').value;
      const assignedToSelect = document.getElementById('assignedTo');
      assignedToSelect.innerHTML = '<option value="">Select</option>';

      if (staffByDepartment[dept]) {
        staffByDepartment[dept].forEach(person => {
          const option = document.createElement('option');
          option.value = person;
          option.textContent = person;
          assignedToSelect.appendChild(option);
        });
      }
    }

    async function fetchClientDetails(type) {
      const clientIdInput = document.getElementById('clientId');
      const clientNameInput = document.getElementById('clientName');
      let query = '';

      if (type === 'id' && clientIdInput.value.trim()) {
        query = `id=${clientIdInput.value.trim()}`;
      } else if (type === 'name' && clientNameInput.value.trim()) {
        query = `name=${clientNameInput.value.trim()}`;
      } else {
        return;
      }

      try {
        const response = await fetch(`/api/clients/fetch?${query}`);
        const data = await response.json();

        if (data && data.client) {
          if (type === 'id') {
            clientNameInput.value = data.client.name || '';
          } else {
            clientIdInput.value = data.client.clientId || '';
          }
        } else {
          console.warn("Client not found");
        }
      } catch (err) {
        console.error("Error fetching client:", err);
      }
    }

  </script>
 <script>
  window.addEventListener('DOMContentLoaded', async () => {
    try {
      const res = await fetch('/api/clients/list');
      const data = await res.json();
      const clientSelect = document.getElementById('clientId');

      clientSelect.innerHTML = '<option value="">Select Client ID</option>';
      data.clients.forEach(client => {
        const option = document.createElement('option');
        option.value = client.clientId;
        option.textContent = client.clientId;
        clientSelect.appendChild(option);
      });
    } catch (error) {
      console.error('Failed to load client IDs:', error);
    }
  });
</script>
<script>
  async function submitProject(event) {
    event.preventDefault();
    const formData = new FormData(event.target);
    const data = Object.fromEntries(formData.entries());

    try {
      const response = await fetch('/api/projects', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
      });

      const result = await response.json();

      if (response.ok) {
        alert('Project created successfully!');
        event.target.reset(); // ✅ Clear all fields

        // ✅ Immediately fetch new Project ID
        const idRes = await fetch('/api/projects/next-id');
        const idData = await idRes.json();
        if (idData.nextProjectId) {
          document.getElementById('projectId').value = idData.nextProjectId;
        }
      } else {
        alert(result.error || 'Failed to create project. Please try again.');
      }
    } catch (error) {
      console.error('Error:', error);
      alert('Error submitting project. Please try again.');
    }
  }

  document.querySelector('form').addEventListener('submit', submitProject);
</script>



  
  
</body>
</html>
 