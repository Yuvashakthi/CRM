<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CRM - Navi Promotions</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="container">
   
    <aside class="sidebar">
      <h2>CRM</h2>
      <ul>
        <li><a href="/dashboard">Dashboard</a></li>
        <li>
          <a href="#" class="dropdown" onclick="toggleDropdown('customerDropdown')">Customers ▾</a>
          <ul id="customerDropdown" class="dropdown-menu">
            <li><a href="/clients">Clients</a></li>
            <li><a href="/customersCreate">Create Client</a></li>
          </ul>
        </li>
        <li>
          <a href="#" class="dropdown" onclick="toggleDropdown('projectDropdown')">Projects ▾</a>
          <ul id="projectDropdown" class="dropdown-menu">
            <li><a href="/projectView">Project View</a></li>
            <li><a href="/projectCreate">Project Create</a></li>
          </ul>
        </li>
        <li>
          <a href="#" class="dropdown" onclick="toggleDropdown('invoiceDropdown')">Invoices ▾</a>
          <ul id="invoiceDropdown" class="dropdown-menu">
            <li><a href="/invoiceView">Invoice View</a></li>
            <li><a href="/invoice">Invoice Create</a></li>
          </ul>
        </li>
        <li>
          <a href="#" class="dropdown" onclick="toggleDropdown('billingDropdown')">Billings ▾</a>
          <ul id="billingDropdown" class="dropdown-menu">
            <li><a href="/billingView">View Billings</a></li>
            <li><a href="/billing">Create Billing</a></li>
          </ul>
        </li>
      </ul>
    </aside>

    
    <main class="content">
      <h1 style="color:#00488E;">Create Project</h1>

      <div class="form-wrapper">
        <div class="form-wrapper">
          <form id="projectForm" class="project-form">
            <label>Project ID:
              <input type="text" id="projectId" name="projectId" readonly required />
            </label>
        
            <label>Project Name:
              <input type="text" id="projectName" name="projectName" required />
            </label>
        
            <label>Client ID:
              <input type="text" id="clientId" name="clientId" oninput="fetchClientDetails('id')" required />
            </label>
        
            <label>Client Name:
              <input type="text" id="clientName" name="clientName" oninput="fetchClientDetails('name')" required />
            </label>
        
            <label>Department:
              <select id="department" name="department" onchange="updateAssignedTo()" required>
                <option value="">Select</option>
                <option value="Development">Development</option>
                <option value="Graphic Designing">Graphic Designing</option>
              </select>
            </label>
        
            <label>Assigned To:
              <select id="assignedTo" name="assignedTo" required>
                <option value="">Select</option>
              </select>
            </label>
        
            <label>Project Type:
              <input type="text" id="projectType" name="projectType" />
            </label>
        
            <label>Start Date:
              <input type="date" id="startDate" name="startDate" />
            </label>
        
            <label>End Date:
              <input type="date" id="endDate" name="endDate" />
            </label>
        
            <label>Status:
              <input type="text" id="status" name="status" />
            </label>
        
            <label>Worth (INR):
              <input type="text" id="worth" name="worth" />
            </label>
        
            <button type="submit">Create Project</button>
          </form>
        </div>
        
      </div>
    </main>
  </div>

  <script src="/script.js"></script>

  <script>

    const staffByDepartment = {
      "Development":       ["Manjubashini", "Yuvashakthi", "Jacinth Sharon"],
      "Graphic Designing": ["Sathees Kumar", "Manoj Kumar"]
    };

    function updateAssignedTo() {
      const deptSel   = document.getElementById('department').value;
      const assigned  = document.getElementById('assignedTo');
      assigned.innerHTML = '<option value="">Select</option>';
      (staffByDepartment[deptSel] || []).forEach(p => {
        assigned.insertAdjacentHTML('beforeend', `<option value="${p}">${p}</option>`);
      });
    }

    async function fetchClientDetails(type) {
      const idInput   = document.getElementById('clientId');
      const nameInput = document.getElementById('clientName');
      const query     = type === 'id'   && idInput.value.trim()
                      ? `id=${idInput.value.trim()}`
                      : type === 'name' && nameInput.value.trim()
                      ? `name=${nameInput.value.trim()}`
                      : '';
      if (!query) return;

      try {
        const res  = await fetch(`/api/clients/fetch?${query}`);
        const { client } = await res.json();
        if (client) {
          idInput.value   = client.clientId ?? idInput.value;
          nameInput.value = client.name     ?? nameInput.value;
        }
      } catch (err) {
        console.error('Error fetching client:', err);
      }
    }

    
    async function loadNextProjectId() {
      try {
        const res  = await fetch('/api/projects/next-id');
        const { nextProjectId } = await res.json();
        document.getElementById('projectId').value = nextProjectId || '';
      } catch (err) {
        console.error('Could not fetch next project ID:', err);
      }
    }


    async function loadClientIds() {
      try {
        const res     = await fetch('/api/clients/list');
        const { clients } = await res.json();
        const select  = document.getElementById('clientId');
        select.insertAdjacentHTML('afterbegin', '<option value="">Select Client ID</option>');
        clients.forEach(c => {
          select.insertAdjacentHTML('beforeend',
            `<option value="${c.clientId}">${c.clientId}</option>`);
        });
      } catch (err) {
        console.error('Failed to load client IDs:', err);
      }
    }

    
    document.getElementById('projectForm').addEventListener('submit', async e => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data     = Object.fromEntries(formData.entries());

      try {
        const res  = await fetch('/api/projects', {
          method : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body   : JSON.stringify(data)
        });
        const json = await res.json();

        if (!res.ok) throw new Error(json.error || 'Unknown error');
        alert(`Project ${json.project.projectId} created!`);
        e.target.reset();
        await loadNextProjectId();
      } catch (err) {
        alert('Failed: ' + err.message);
      }
    });


    window.addEventListener('DOMContentLoaded', async () => {
      await loadClientIds();
      await loadNextProjectId();
    });
  </script>
</body>
</html>
