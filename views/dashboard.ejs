<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CRM - Navi Promotions</title>
  <link rel="stylesheet" href="/styles.css" />
  
</head>
<body>
  <div class="container">
    <!-- Sidebar Navigation -->
    <aside class="sidebar">
      <h2>CRM</h2>
      <ul>
        <li><a href="/dashboard">Dashboard</a></li>
        <li><a href="#" class="dropdown" onclick="toggleDropdown('customerDropdown')">Customers ▾</a>
          <ul id="customerDropdown" class="dropdown-menu">
            <li><a href="/clients">Clients</a></li>
            <li><a href="/customersCreate">Create Client</a></li>
          </ul>
        </li>
        <li><a href="#" class="dropdown" onclick="toggleDropdown('projectDropdown')">Projects ▾</a>
          <ul id="projectDropdown" class="dropdown-menu">
            <li><a href="/projectView">Project View</a></li>
            <li><a href="/projectCreate">Project Create</a></li>
          </ul>
        </li>
        <li><a href="#" class="dropdown" onclick="toggleDropdown('invoiceDropdown')">Invoices ▾</a>
          <ul id="invoiceDropdown" class="dropdown-menu">
            <li><a href="/invoiceView">Invoice View</a></li>
            <li><a href="/invoice">Invoice Create</a></li>
          </ul>
        </li>
        <li><a href="#" class="dropdown" onclick="toggleDropdown('billingDropdown')">Billings ▾</a>
          <ul id="billingDropdown" class="dropdown-menu">
            <li><a href="/billingView">View Billings</a></li>
            <li><a href="/billing">Create Billing</a></li>
          </ul>
        </li>
      </ul>
    </aside>

    <main class="content" id="content">
      <h1>Dashboard Overview</h1>

      <!-- Client Summary Row -->
      <div class="card-row" id="client-summary">
        <div class="card"><h3>Total Clients</h3><span id="totalClients">--</span></div>
        <div class="card"><h3>Active Clients</h3><span id="activeClients">--</span></div>
        <div class="card"><h3>Inactive Clients</h3><span id="inactiveClients">--</span></div>
      </div>

      <!-- Invoice Summary Row -->
      <div class="card-row" id="invoice-summary">
        <div class="card"><h3>Total Invoice Amount</h3><span id="invoiceTotal">--</span></div>
        <div class="card"><h3>Paid / Partial</h3><span id="invoicePaid">--</span></div>
        <div class="card"><h3>Unpaid</h3><span id="invoiceUnpaid">--</span></div>
      </div>

      <!-- Billing Summary Row -->
      <div class="card-row" id="billing-summary">
        <div class="card"><h3>Total Billings</h3><span id="billingCount">--</span></div>
        <div class="card"><h3>Paid Amount</h3><span id="billingPaid">--</span></div>
        <div class="card"><h3>Unpaid Amount</h3><span id="billingUnpaid">--</span></div>
      </div>
    </main>
  </div>

 
  <script>
    window.addEventListener("DOMContentLoaded", async () => {
      try {
        const res = await fetch('/dashboard/stats');
        const data = await res.json();
  
        // Clients
        document.getElementById('totalClients').textContent = data.clients.total;
        document.getElementById('activeClients').textContent = data.clients.active;
        document.getElementById('inactiveClients').textContent = data.clients.inactive;
  
        // Invoices
        document.getElementById('invoiceTotal').textContent = `₹${data.invoices.totalAmount.toFixed(2)}`;
        document.getElementById('invoicePaid').textContent = data.invoices.paidCount;
        document.getElementById('invoiceUnpaid').textContent = data.invoices.unpaidCount;
  
        // Billings
        document.getElementById('billingCount').textContent = data.billings.total;
        document.getElementById('billingPaid').textContent = `₹${data.billings.totalPaid.toFixed(2)}`;
        const unpaid = (data.invoices.totalAmount - data.billings.totalPaid).toFixed(2);
        document.getElementById('billingUnpaid').textContent = `₹${unpaid}`;
      } catch (err) {
        console.error("Failed to load dashboard stats", err);
      }
    });
  </script>
  
  
</body>
</html>
